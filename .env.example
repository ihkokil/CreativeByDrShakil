# Neon Database
NEON_DATABASE_URL="postgresql://user:pass@host.neon.tech/neondb?sslmode=require"
NEON_DIRECT_URL="postgresql://user:pass@host.neon.tech/neondb?sslmode=require"

# Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Resend Email API
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Creative by Dr. Shakil <no-reply@creativebydrshakil.com>"

# Google OAuth (direct fetch-based, no NextAuth)
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telegram Integration
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here" # Comma-separated for multiple chats

# Hostinger Storage Upload Variables
NEXT_PUBLIC_FILE_URL="https://your-public-cdn-or-domain.com"
HOSTINGER_UPLOAD_TOKEN="your_upload_token"

# Default Email Domain
DEFAULT_EMAIL_DOMAIN="creativebydrshakil.com"
NEXT_PUBLIC_DEFAULT_EMAIL_DOMAIN="creativebydrshakil.com"

# Upload Size Limits (in MB)
# DEFAULT_VIDEO_MAX_SIZE=1024
# DEFAULT_DOC_MAX_SIZE=50

