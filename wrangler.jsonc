{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creativebydrshakil",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2026-06-16",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ]
}
