{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creativebydrshakil",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXTAUTH_URL": "https://web.creativebydrshakil.com",
    "APP_URL": "https://web.creativebydrshakil.com",
    "NEXT_PUBLIC_APP_URL": "https://web.creativebydrshakil.com"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"]
    }
  ]
}
