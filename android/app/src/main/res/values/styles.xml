<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main App Theme (Pure OLED Dark Background, No ActionBar, Zero White Flash) -->
    <style name="Theme.CreativeByDrShakil" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/brand_crimson</item>
        <item name="colorPrimaryDark">@color/oled_bg</item>
        <item name="colorAccent">@color/brand_crimson</item>
        <item name="android:windowBackground">@color/oled_bg</item>
        <item name="android:colorBackground">@color/oled_bg</item>
        <item name="android:statusBarColor">@color/oled_bg</item>
        <item name="android:navigationBarColor">@color/oled_bg</item>
    </style>

    <!-- Splash Screen Theme for Android 7.0 (API 24) through Android 11 (API 30) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/oled_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="android:windowBackground">@drawable/splash_legacy_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.CreativeByDrShakil</item>
    </style>
</resources>
