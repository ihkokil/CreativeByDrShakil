  "description": "Creative By Dr. Shakil [creativebydrshakil.com] — medical education simplified.",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{ recursive: true, force: true })\"",
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "dev:webpack": "next dev --webpack",
    "build": "npm run clean && prisma generate && next build --webpack",
    "build:worker": "npx prisma generate && npx opennextjs-cloudflare build && node scripts/patch-handler.js",
    "deploy": "npm run build:worker && wrangler deploy",
    "preview": "npx opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "seed:teachers": "node scripts/seed-teachers.mjs",
    "seed:videos": "node scripts/seed-video-library.mjs"
  },
