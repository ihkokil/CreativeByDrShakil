generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                      @id @default(cuid())
  email                       String                      @unique
  phone                       String?                     @unique
  passwordHash                String?
  fullName                    String
  role                        UserRole                    @default(student)
  bmdcNumber                  String?
  designation                 String?
  institution                 String?
  degrees                     String?
  profileImage                String?
  emailVerified               Boolean                     @default(true)
  emailVerificationTokenHash  String?
  emailVerificationExpires    DateTime?
  passwordResetTokenHash      String?
  passwordResetExpires        DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  canManagePayments           Boolean                     @default(false)
  isBanned                    Boolean                     @default(false)
  telegramChatId              String?
  image                       String?
  isSessionLockedExempt       Boolean                     @default(false)
  accounts                    Account[]
  contactReplies              ContactSubmission[]         @relation("ContactSubmissionReplies")
  teacherCourses              Course[]                    @relation("TeacherCourses")
  deviceSessions              DeviceSession[]
  lessonProgress              LessonProgress[]
  orders                      Order[]
  sessions                    Session[]
  sessionSettings             SessionLockSettings?
  moduleAvailabilityOverrides StudentModuleAvailability[]
  batchId                     String?
  batch                       Batch?                      @relation("StudentBatch", fields: [batchId], references: [id])
  enrollmentDate              DateTime?
}

model Course {
  id                          String                      @id @default(cuid())
  slug                        String?                     @unique
  title                       String
  description                 String
  overview                    String?
  categoryId                  String?
  price                       Float
  salePrice                   Float?
  instructor                  String
  language                    String?
  imageUrl                    String?
  duration                    String
  courseStartDate              DateTime?
  learningOutcomes            String?
  teacherId                   String?
  status                      CoursePublishStatus         @default(draft)
  timezone                    String                      @default("Asia/Dhaka")
  releaseMode                 CourseReleaseMode?
  releaseStartAt              DateTime?
  releaseIntervalDays         Int?
  releaseGroupsPerWeek        Int?
  releaseGroupDates           String?
  curriculumJson              String?
  publishedAt                 DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  isFeatured                  Boolean                     @default(false)
  releaseDaysOfWeek           String?
  Category                    Category?                   @relation(fields: [categoryId], references: [id])
  teacher                     User?                       @relation("TeacherCourses", fields: [teacherId], references: [id])
  instructors                 CourseInstructor[]
  lessonProgress              LessonProgress[]
  orders                      Order[]
  moduleAvailabilityOverrides StudentModuleAvailability[]

  @@index([teacherId])
  @@index([status])
  @@index([categoryId])
}

model LessonProgress {
  id           String   @id @default(cuid())
  userId       String
  courseId      String
  lessonNodeId String
  completedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lessonNodeId])
  @@index([userId, courseId])
  @@index([courseId])
}

model StudentModuleAvailability {
  id               String    @id @default(cuid())
  courseId         String
  userId           String
  lessonNodeId     String
  availabilityMode String    @default("available")
  availableAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId, lessonNodeId])
  @@index([courseId, userId])
  @@index([courseId, lessonNodeId])
  @@index([userId])
}

model CourseInstructor {
  id          String   @id @default(cuid())
  courseId    String
  name        String
  designation String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Order {
  id          String    @id @default(cuid())
  userId      String
  courseId     String
  status      String    @default("pending")
  totalAmount Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  enrolledAt  DateTime? @default(now())
  expiresAt   DateTime?
  course      Course    @relation(fields: [courseId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment     Payment?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Payment {
  id            String    @id @default(cuid())
  orderId       String    @unique
  phoneNumber   String
  transactionId String
  amount        Float
  status        String    @default("pending")
  submittedAt   DateTime  @default(now())
  approvedAt    DateTime?
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentConfig {
  id              String   @id @default("default")
  provider        String   @default("bkash")
  sendMoneyNumber String
  qrCodeUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactSubmission {
  id               String                  @id @default(cuid())
  fullName         String
  email            String
  phone            String
  issueType        ContactIssueType
  subject          String
  message          String
  imageUrls        String?
  status           ContactSubmissionStatus @default(open)
  adminReply       String?
  adminReplySentAt DateTime?
  repliedByAdminId String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  repliedByAdmin   User?                   @relation("ContactSubmissionReplies", fields: [repliedByAdminId], references: [id])

  @@index([status])
  @@index([issueType])
  @@index([createdAt])
  @@index([email])
  @@index([repliedByAdminId])
}

model DeviceSession {
  id                 String     @id @default(cuid())
  userId             String
  deviceType         DeviceType
  browserName        String
  userAgent          String
  ipAddress          String
  isLocked           Boolean    @default(false)
  loggedOutAt        DateTime?
  createdAt          DateTime   @default(now())
  lastActivityAt     DateTime   @default(now())
  deviceHash         String?
  deviceLabel        String?
  osInfo             String?
  lockedByDeviceLabel String?
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceType])
}

model SessionLockSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  autoLockFirstBrowser Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GlobalSessionLockSettings {
  id                     String   @id @default("global")
  autoLockFirstBrowser   Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  allowDesktop           Boolean  @default(true)
  allowTablet            Boolean  @default(true)
  allowMobile            Boolean  @default(true)
  maxConcurrentSessions  Int      @default(3)
}

model VideoLibraryNode {
  id          String             @id @default(cuid())
  title       String
  type        String
  url         String?
  duration    String?
  parentId    String?
  attachments Json?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  parent      VideoLibraryNode?  @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    VideoLibraryNode[] @relation("NodeTree")

  @@index([parentId])
}

model Category {
  id          String   @id
  name        String   @unique
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Course      Course[]
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  admin
  teacher
  student
}

enum CoursePublishStatus {
  draft
  scheduled
  published
  archived
}

enum CourseReleaseMode {
  fixed_interval
  groups_per_week
  day_of_week
  explicit_dates
  instant
  circular
}

model Batch {
  id             String    @id @default(cuid())
  name           String
  enrollmentDate DateTime
  students       User[]    @relation("StudentBatch")
}

enum ContactIssueType {
  query
  technical_assistance
  billing
  course_access
  other
}

enum ContactSubmissionStatus {
  open
  in_review
  responded
  closed
}

enum DeviceType {
  desktop
  mobile
  tablet
}
