generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  teacher
  student
}

enum CoursePublishStatus {
  draft
  scheduled
  published
  archived
}

enum CourseReleaseMode {
  fixed_interval
  groups_per_week
  explicit_dates
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  fullName     String
  role         UserRole @default(student)
  bmdcNumber   String?
  designation  String?
  institution  String?
  degrees      String?
  profileImage               String?  @db.LongText
  emailVerified              Boolean  @default(true)
  emailVerificationTokenHash String?  @db.VarChar(255)
  emailVerificationExpires   DateTime?
  passwordResetTokenHash     String?              @db.VarChar(255)
  passwordResetExpires       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
  teacherCourses Course[] @relation("TeacherCourses")
  deviceSessions             DeviceSession[]
  sessionSettings            SessionLockSettings?
}

model Course {
  id           String   @id @default(cuid())
  slug         String?  @unique
  title        String
  description  String   @db.LongText
  category     String?
  price        Float
  instructor   String
  language     String?
  level        String?
  imageUrl     String?  @db.LongText
  duration     String
  teacherId    String?
  teacher      User?    @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: SetNull)
  status       CoursePublishStatus @default(draft)
  timezone     String             @default("Asia/Dhaka")
  releaseMode  CourseReleaseMode?
  releaseStartAt DateTime?
  releaseIntervalDays Int?
  releaseGroupsPerWeek Int?
  releaseGroupDates Json?
  curriculumJson Json?
  publishedAt DateTime?
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teacherId])
  @@index([status])
}

model Order {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  status         String   @default("pending")
  totalAmount    Float
  couponCode     String?
  discountAmount Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  course         Course   @relation(fields: [courseId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment        Payment?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  phoneNumber   String
  transactionId String
  amount        Float
  status        String   @default("pending")
  submittedAt   DateTime @default(now())
  approvedAt    DateTime?
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  discountAmount Float
  maxUses        Int      @default(-1)
  usedCount      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PaymentConfig {
  id              String   @id @default("default")
  provider        String   @default("bkash")
  sendMoneyNumber String
  qrCodeUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum DeviceType {
  desktop
  mobile
}

model DeviceSession {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType     DeviceType
  browserName    String
  userAgent      String     @db.LongText
  ipAddress      String
  isLocked       Boolean    @default(false)
  loggedOutAt    DateTime?
  createdAt      DateTime   @default(now())
  lastActivityAt DateTime   @default(now())

  @@index([userId])
  @@index([userId, deviceType])
}

model SessionLockSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoLockFirstBrowser Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model GlobalSessionLockSettings {
  id                   String   @id @default("global")
  autoLockFirstBrowser Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model VideoLibraryNode {
  id        String   @id @default(cuid())
  title     String
  type      String   // 'folder' | 'youtube' | 'self-hosted' | 'document'
  url       String?  @db.Text
  duration  String?
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   VideoLibraryNode?  @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children VideoLibraryNode[] @relation("NodeTree")

  @@index([parentId])
}
