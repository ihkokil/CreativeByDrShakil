generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model User {
  id                          String                      @id @default(cuid())
  email                       String                      @unique
  phone                       String?                     @unique
  passwordHash                String
  fullName                    String
  role                        UserRole                    @default(student)
  bmdcNumber                  String?
  designation                 String?
  institution                 String?
  degrees                     String?
  profileImage                String?                     @db.LongText
  emailVerified               Boolean                     @default(true)
  emailVerificationTokenHash  String?                     @db.VarChar(255)
  emailVerificationExpires    DateTime?
  passwordResetTokenHash      String?                     @db.VarChar(255)
  passwordResetExpires        DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  contactReplies              ContactSubmission[]         @relation("ContactSubmissionReplies")
  teacherCourses              Course[]                    @relation("TeacherCourses")
  deviceSessions              DeviceSession[]
  lessonProgress              LessonProgress[]
  orders                      Order[]
  sessionSettings             SessionLockSettings?
  canManagePayments           Boolean                     @default(false)
  moduleAvailabilityOverrides StudentModuleAvailability[]
}

model Course {
  id                          String                      @id @default(cuid())
  slug                        String?                     @unique
  title                       String
  description                 String                      @db.LongText
  overview                    String?                     @db.LongText
  categoryId                  String?
  price                       Float
  salePrice                   Float?
  instructor                  String
  language                    String?
  imageUrl                    String?                     @db.LongText
  duration                    String
  courseStartDate             DateTime?
  learningOutcomes            String?                     @db.LongText
  teacherId                   String?
  status                      CoursePublishStatus         @default(draft)
  timezone                    String                      @default("Asia/Dhaka")
  releaseMode                 CourseReleaseMode?
  releaseStartAt              DateTime?
  releaseIntervalDays         Int?
  releaseGroupsPerWeek        Int?
  releaseGroupDates           String?                     @db.LongText
  curriculumJson              String?                     @db.LongText
  publishedAt                 DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  isFeatured                  Boolean                     @default(false)
  releaseDaysOfWeek           String?                     @db.LongText
  category                    Category?                   @relation(fields: [categoryId], references: [id])
  teacher                     User?                       @relation("TeacherCourses", fields: [teacherId], references: [id])
  instructors                 CourseInstructor[]
  lessonProgress              LessonProgress[]
  orders                      Order[]
  moduleAvailabilityOverrides StudentModuleAvailability[]

  @@index([teacherId])
  @@index([categoryId])
  @@index([status])
}

model LessonProgress {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  lessonNodeId String
  completedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lessonNodeId])
  @@index([userId, courseId])
  @@index([courseId])
}

model StudentModuleAvailability {
  id               String    @id @default(cuid())
  courseId         String
  userId           String
  lessonNodeId     String
  availabilityMode String    @default("available")
  availableAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId, lessonNodeId])
  @@index([courseId, userId])
  @@index([courseId, lessonNodeId])
  @@index([userId], map: "StudentModuleAvailability_userId_fkey")
}

model CourseInstructor {
  id          String   @id @default(cuid())
  courseId    String
  name        String
  designation String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?  @db.LongText
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Order {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  status         String   @default("pending")
  totalAmount    Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  course         Course   @relation(fields: [courseId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment        Payment?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Payment {
  id            String    @id @default(cuid())
  orderId       String    @unique
  phoneNumber   String
  transactionId String
  amount        Float
  status        String    @default("pending")
  submittedAt   DateTime  @default(now())
  approvedAt    DateTime?
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}


model PaymentConfig {
  id              String   @id @default("default")
  provider        String   @default("bkash")
  sendMoneyNumber String
  qrCodeUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactSubmission {
  id               String                  @id @default(cuid())
  fullName         String
  email            String
  phone            String
  issueType        ContactIssueType
  subject          String
  message          String                  @db.LongText
  imageUrls        String?                 @db.LongText
  status           ContactSubmissionStatus @default(open)
  adminReply       String?                 @db.LongText
  adminReplySentAt DateTime?
  repliedByAdminId String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  repliedByAdmin   User?                   @relation("ContactSubmissionReplies", fields: [repliedByAdminId], references: [id])

  @@index([status])
  @@index([issueType])
  @@index([createdAt])
  @@index([email])
  @@index([repliedByAdminId], map: "ContactSubmission_repliedByAdminId_fkey")
}

model DeviceSession {
  id             String     @id @default(cuid())
  userId         String
  deviceType     DeviceType
  browserName    String
  userAgent      String     @db.LongText
  ipAddress      String
  isLocked       Boolean    @default(false)
  loggedOutAt    DateTime?
  createdAt      DateTime   @default(now())
  lastActivityAt DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceType])
}

model SessionLockSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  autoLockFirstBrowser Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GlobalSessionLockSettings {
  id                   String   @id @default("global")
  autoLockFirstBrowser Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model VideoLibraryNode {
  id        String             @id @default(cuid())
  title     String
  type      String
  url       String?            @db.Text
  duration  String?
  parentId  String?
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  parent    VideoLibraryNode?  @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  VideoLibraryNode[] @relation("NodeTree")

  @@index([parentId])
}

enum UserRole {
  admin
  teacher
  student
}

enum CoursePublishStatus {
  draft
  scheduled
  published
  archived
}

enum CourseReleaseMode {
  fixed_interval
  groups_per_week
  day_of_week
  explicit_dates
  instant
}

enum ContactIssueType {
  query
  technical_assistance
  billing
  course_access
  other
}

enum ContactSubmissionStatus {
  open
  in_review
  responded
  closed
}

enum DeviceType {
  desktop
  mobile
}
